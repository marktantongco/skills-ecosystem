{
  "name": "skills-ecosystem",
  "version": "1.0.0",
  "private": true,
  "description": "Agent Skills Ecosystem — Award-winning interactive showcase of the open agent skills platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
