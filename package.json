    "deploy:vercel": "npx vercel --prod"
  },
  "dependencies": {
    "next": "^16.2.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "framer-motion": "^11.0.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.400.0",
    "next-pwa": "^5.6.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  },
  "next-pwa": {
    "dest": "public",
    "register": true,
    "skipWaiting": true
  }
